# Supabase Configuration - used by the Vite frontend (browser-exposed,
# safe by design: access is enforced by Row Level Security, not secrecy).
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Only needed to run check_rls.cjs (a local admin diagnostic script).
# Get it from Supabase Dashboard -> Project Settings -> Database ->
# Connection string. Never prefix this with VITE_ - anything prefixed
# VITE_ is bundled into the browser build.
# SUPABASE_DB_URL=postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Not set here on purpose: the Edge Function (supabase/functions/ingest-telemetry)
# uses SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY, which
# Supabase injects automatically into every deployed function's runtime -
# nothing to configure.
